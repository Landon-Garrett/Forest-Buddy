import csv
import math
import os
import time

folder_path = "C:/Temp/Pixhawk_IMU_Logs"
if not os.path.exists(folder_path):
    os.makedirs(folder_path)

output_file = os.path.join(folder_path, "pixhawk_imu_data.csv")

total_samples = 1000
sample_delay_ms = 50  # 50 ms = 20 Hz (50 seconds total)

print("Starting 50-second capture (1000 samples)...")

with open(output_file, mode="w", newline="") as file:
    writer = csv.writer(file)
    writer.writerow([
        "Sample_Index",
        "Elapsed_Time (s)",
        "AccX (mG)",
        "AccY (mG)",
        "AccZ (mG)",
        "GyroX (deg/s)",
        "GyroY (deg/s)",
        "GyroZ (deg/s)",
        "EKF_Roll (deg)",
        "AHRS2_Roll (deg)",
        "Pitch (deg)",
        "Yaw (deg)",
    ])

    start_time = time.time()

    for i in range(total_samples):
        elapsed = round(time.time() - start_time, 3)

        # Read AHRS2 packet (MAVLink ID 178) and convert radians to degrees
        pkt = MAV.getPacket(178)
        if pkt is not None:
            ahr_roll = math.degrees(pkt.ToStructure().roll)
        else:
            ahr_roll = ""

        writer.writerow([
            i + 1,
            elapsed,
            cs.ax,
            cs.ay,
            cs.az,
            cs.gx,
            cs.gy,
            cs.gz,
            cs.roll,
            ahr_roll,
            cs.pitch,
            cs.yaw,
        ])

        if (i + 1) % 100 == 0:
            print(
                "Recorded {}/{} samples ({:.1f}s elapsed)".format(
                    i + 1, total_samples, elapsed
                )
            )

        Script.Sleep(sample_delay_ms)

print("Capture complete! Opening in Excel...")
os.startfile(output_file)
